
<div class="layout layout--col gap--xsmall">
  <span class="value value--small">{{ icao }}</span>
  {% for p in periods limit:4 %}
    <div class="item">
      <div class="content">
        <span class="title title--small">{{ p.label }}</span>
        <span class="label label--small">{{ p.wind }} {{ p.vis }}</span>
      </div>
    </div>
  {% endfor %}
</div>
<div class="title_bar">
  <span class="title">TAF</span>
</div>
